{
  "state": {
    "pkey": "state",
    "keylen": 6,
    "resolver": "hashkey",
    "data": [
      { "status": "Enabled", "description": "Enabled for trading" },
      { "status": "Disabled", "description": "Disabled from trading" },
      { "status": "Halted", "description": "Adverse event halt" },
      { "status": "Restricted", "description": "Restricted use" },
      { "status": "Suspended", "description": "Suspended by broker" },
      { "status": "Deleted", "description": "Deleted pending removal" },
      { "status": "Expired", "description": "Expired; order requests, tokens, keys, et al" },
      { "status": "Queued", "description": "Queued; request queued for handling" },
      { "status": "Pending", "description": "Pending; request is live/pending" },
      { "status": "Fulfilled", "description": "Fulfilled; order fullfilled; check orders for completion" },
      { "status": "Rejected", "description": "Rejected; request denied; check error log" },
      { "status": "Canceled", "description": "Canceled; request canceled;" },
      { "status": "Hold", "description": "Hold; request on hold pending cancel;" },
      { "status": "Closed", "description": "Closed; request is closed;" },
      { "status": "Open", "description": "Open; order/position is open;" }
    ]
  },
  "authority": {
    "pkey": "authority",
    "keylen": 6,
    "resolver": "hashkey",
    "data": [
      { "privilege": "View", "priority": 0 },
      { "privilege": "Edit", "priority": 1 },
      { "privilege": "Create", "priority": 2 },
      { "privilege": "Delete", "priority": 3 },
      { "privilege": "Operate", "priority": 4 },
      { "privilege": "Configure", "priority": 5 }
    ]
  },
  "broker": {
    "pkey": "broker",
    "keylen": 6,
    "resolver": "hashkey",
    "data": [{ "name": "Blofin", "image_url": "./images/broker/blofin.png", "website_url": "https://blofin.com/" }]
  },
  "process_state": {
    "pkey": "process_state",
    "keylen": 4,
    "resolver": "hashkey",
    "data": [
      { "process_status": "running", "description": "Processes currently heartbeating in the OS" },
      { "process_status": "stopped", "description": "Existing jobs that are currently shut down" },
      { "process_status": "error", "description": "Processes that exited with non-zero codes" },
      { "process_status": "unprovisioned", "description": "Enabled instruments with no entry in job_control" },
      { "process_status": "starting", "description": "Processes actively attempting to boot up" },
      { "process_status": "stopping", "description": "Processes attempting to shutdown" },
      { "process_status": "paused", "description": "Paused processes waiting for restart" },
      { "process_status": "halted", "description": "Halted and unable to restart" },
      { "process_status": "inactive", "description": "Processes inactivated and pending remvoal" },
      { "process_state": "0xdead", "process_status": "dead", "description": "Process was adversly halted" }
    ]
  },
  "account_type": {
    "pkey": "account_type",
    "keylen": 2,
    "resolver": "hashkey",
    "data": [
      { "account_type": "0x00", "ident": "PROD", "environment": "Production", "description": "Primary live production, real-money account" },
      { "account_type": "0x01", "ident": "PROD", "environment": "Production", "description": "Online Redundancy live production, real-money account" },
      {
        "account_type": "0xB1",
        "ident": "TEST",
        "environment": "Test",
        "description": "Non-attached with connection capability account for internal use only"
      },
      { "account_type": "0xC0", "ident": "COOP", "environment": "Continuity", "description": "Offline Continuity of Operations, DRP, production backup" },
      { "account_type": "0xD1", "ident": "DEMO", "environment": "Demonstration", "description": "A live demonstration, paper trading account" },
      { "account_type": "0xD2", "ident": "DEMO", "environment": "Demonstration", "description": "A live demonstration, paper trading account" },
      { "account_type": "0xD3", "ident": "DEMO", "environment": "Demonstration", "description": "A live demonstration, paper trading account" },
      { "account_type": "0xE1", "ident": "DEV1", "environment": "Development", "description": "Non-attached and non-connecting account for internal use only" },
      { "account_type": "0xF0", "ident": "OFFP", "environment": "Fail-Over", "description": "Offline production failover reserve api keys" },
      { "account_type": "0xF1", "ident": "OFFP", "environment": "Fail-Over", "description": "Offline production failover reserve api keys" },
      { "account_type": "0xF2", "ident": "OFFP", "environment": "Fail-Over", "description": "Offline production failover reserve api keys" }
    ]
  },
  "command": {
    "pkey": "command",
    "keylen": 2,
    "resolver": "hashkey",
    "data": [
      { "execute": "start", "description": "Start a new job control process" },
      { "execute": "stop", "description": "Stop a process by symbol" },
      { "execute": "restart", "description": "Restart process by symbol" },
      { "execute": "pause", "description": "Pause the execution of the symbol" },
      { "execute": "resume", "description": "Resume the execution of the symbol" },
      { "execute": "halt", "description": "Attempt a graceful shutdown of the master job" },
      { "execute": "kill", "description": "Forcefully shutdown all processing" }
    ]
  },
  "config_param": {
    "pkey": "config_param",
    "resolver": "text",
    "lookup": {
      "column": "state",
      "table": "state",
      "key": { "status": "Enabled" }
    },
    "data": [
      { "config_param": "apiCooldownMs", "default_param_value": "1200", "value_type": "int" },
      { "config_param": "apiTimeoutTimeMs", "default_param_value": "300000", "value_type": "int" },
      { "config_param": "candleMaxFetch", "default_param_value": "1440", "value_type": "int" },
      { "config_param": "defaultLeverage", "default_param_value": "10", "value_type": "int" },
      { "config_param": "defaultSma", "default_param_value": "60", "value_type": "int" },
      { "config_param": "defaultTimeframe", "default_param_value": "15m", "value_type": "string" },
      { "config_param": "ipcPingTimeMs", "default_param_value": "500", "value_type": "int" },
      { "config_param": "leverageMaxFetch", "default_param_value": "20", "value_type": "int" },
      { "config_param": "masterCycleTimeMs", "default_param_value": "2000", "value_type": "int" },
      { "config_param": "orderMaxFetch", "default_param_value": "100", "value_type": "int" },
      { "config_param": "wssPingTimeMs", "default_param_value": "29000", "value_type": "int" }
    ]
  },
  "period": {
    "pkey": "period",
    "keylen": 6,
    "resolver": "hashkey",
    "data": [
      { "timeframe": "1m", "timeframe_minutes": 1, "description": "1 Minute" },
      { "timeframe": "3m", "timeframe_minutes": 3, "description": "3 Minutes" },
      { "timeframe": "5m", "timeframe_minutes": 5, "description": "5 Minutes" },
      { "timeframe": "15m", "timeframe_minutes": 15, "description": "15 Minutes" },
      { "timeframe": "30m", "timeframe_minutes": 30, "description": "30 Minutes" },
      { "timeframe": "1H", "timeframe_minutes": 60, "description": "1 Hour" },
      { "timeframe": "2H", "timeframe_minutes": 120, "description": "2 Hours" },
      { "timeframe": "4H", "timeframe_minutes": 240, "description": "4 Hours" },
      { "timeframe": "6H", "timeframe_minutes": 360, "description": "6 Hours" },
      { "timeframe": "8H", "timeframe_minutes": 480, "description": "8 Hours" },
      { "timeframe": "12H", "timeframe_minutes": 720, "description": "12 Hours" },
      { "timeframe": "1D", "timeframe_minutes": 1440, "description": "1 Day" },
      { "timeframe": "3D", "timeframe_minutes": 4320, "description": "3 Days" },
      { "timeframe": "1W", "timeframe_minutes": 10080, "description": "1 Week" },
      { "timeframe": "1M", "timeframe_minutes": 0, "description": "1 Month" }
    ]
  },
  "role": {
    "pkey": "role",
    "keylen": 6,
    "resolver": "hashkey",
    "data": [
      { "title": "Admin", "auth_rank": 40 },
      { "title": "Editor", "auth_rank": 20 },
      { "title": "Operator", "auth_rank": 30 },
      { "title": "Viewer", "auth_rank": 10 }
    ]
  },
  "task_group": {
    "pkey": "task_group",
    "keylen": 6,
    "resolver": "hashkey",
    "data": [
      { "group_name": "Instruments", "description": "Administration of Instruments including currencies, types, and contracts;" },
      { "group_name": "Trading", "description": "Job/Symbol operations and parameter configuration;" },
      { "group_name": "Users", "description": "User management and administration including roles, privileges, and authorized activities;" },
      { "group_name": "Accounts", "description": "Account administration including keys, brokers, and operational availability;" },
      { "group_name": "Jobs", "description": "Operational management of Jobs including starts, stoppages, and monitoring;" }
    ]
  },
  "activity": {
    "pkey": "activity",
    "keylen": 6,
    "resolver": "hashkey",
    "refers": ["task_group", "group_name"],
    "data": [
      { "task_group": "Instruments", "task_name": "Manage Instruments" },
      { "task_group": "Instruments", "task_name": "View/Modify Contracts" },
      { "task_group": "Instruments", "task_name": "View/Modify Instrument Types" },
      { "task_group": "Trading", "task_name": "Configure trading options" },
      { "task_group": "Users", "task_name": "Manage Users" },
      { "task_group": "Accounts", "task_name": "Account Administration" },
      { "task_group": "Jobs", "task_name": "Configure jobs" },
      { "task_group": "Jobs", "task_name": "Monitor jobs" }
    ]
  }
}
